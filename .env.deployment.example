# Backend Deployment Secrets
# Copy this file to .env.deployment and fill in your values, then run ./sync-secrets.sh

# AWS Credentials for CI/CD deployment
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# ECR & EC2 Identifiers
ECR_BACKEND_REPO=inovo-backend
BACKEND_INSTANCE_NAME=inovo-backend
BACKEND_PORT=8000

# Application Configuration
ENVIRONMENT=production
SECRET_KEY=replace-with-a-secure-secret-key
INTERNAL_API_KEY=replace-with-a-secure-internal-api-key

# Database & Cache (Fill in rds_endpoint from terraform output)
# Format: postgresql+asyncpg://inventory:<DB_PASSWORD>@<RDS_ENDPOINT>/inventory
DATABASE_URL=postgresql+asyncpg://inventory:your_db_password@<RDS_ENDPOINT>/inventory
REDIS_URL=redis://localhost:6379/0

# S3 Avatars
S3_BUCKET_NAME=prod-inovo-bucket
AWS_S3_REGION=us-east-1
